<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ImprovedGarrisons.CoopBootstrap</AssemblyName>
    <RootNamespace>ImprovedGarrisons.CoopBootstrap</RootNamespace>
    <Version>1.1.4</Version>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <FileVersion>1.1.4.0</FileVersion>
    <InformationalVersion>1.1.4</InformationalVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TaleWorlds.Core">
      <HintPath>../../VanillaSourceFiles/Win64_Shipping_Client/TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>../../VanillaSourceFiles/Win64_Shipping_Client/TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CopyModuleArtifacts" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(MSBuildThisFileDirectory)../../ImprovedGarrisons/bin/Win64_Shipping_Client/$(TargetFileName)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(MSBuildThisFileDirectory)../../ImprovedGarrisons/bin/Win64_Shipping_Server/$(TargetFileName)" />
  </Target>
</Project>
